# ============================================================
# Copy this file to deployment/.env and fill in real values
# before running docker compose. Never commit the real .env file.
# ============================================================

# --- MySQL ---
DB_NAME=society_management
DB_USERNAME=society_user
DB_PASSWORD=change_this_strong_password
DB_ROOT_PASSWORD=change_this_root_password

# --- JWT ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_base64_secret
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Comma-separated list of origins allowed to call the API directly.
# When using the bundled nginx (frontend container proxies /api to backend),
# this can usually stay as the site's own origin(s).
CORS_ALLOWED_ORIGINS=http://localhost,http://YOUR_EC2_PUBLIC_IP

# --- Frontend build-time API base URL ---
# Keep as /api to use the nginx reverse proxy shipped in frontend/nginx.conf.
VITE_API_BASE_URL=/api
